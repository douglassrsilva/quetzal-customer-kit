command:
  - python
  - -m
  - uvicorn
  - app:app
  - --host
  - 0.0.0.0
  - --port
  - "8000"

# Este archivo se utiliza únicamente para diagnóstico local. resources/app.yml
# es la fuente de configuración y agrega los identificadores durante el despliegue.
env:
  - name: QUETZAL_CATALOG
    value: "<catalogo>"
  - name: QUETZAL_SCHEMA
    value: "quetzal"
  - name: DATABRICKS_WAREHOUSE_ID
    value: "<warehouse_id>"
  - name: QUETZAL_AI_MODEL
    value: "<catalog>.<schema>.<model_service>"
  - name: QUETZAL_ALLOW_LOCAL_IDENTITY_FALLBACK
    value: "false"
