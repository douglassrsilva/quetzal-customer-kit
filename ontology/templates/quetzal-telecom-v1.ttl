@prefix qz: <{{ontology_base_uri}}/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ontobricks: <http://ontobricks.com/schema#> .

<{{ontology_base_uri}}/ontology> a owl:Ontology ;
  owl:versionInfo "1.0.0" ;
  rdfs:label "Quetzal Telecom Knowledge Graph"@en ;
  rdfs:comment "Ontología gobernada para clientes, servicio, relaciones y decisiones de retención. qualifiedContact representa una asociación observada, nunca causalidad de churn."@es .

qz:Customer a owl:Class ; rdfs:label "Cliente"@es ; ontobricks:icon "👤" .
qz:QualifiedContact a owl:Class ;
  rdfs:label "Contacto calificado"@es ;
  rdfs:comment "Relación derivada de recurrencia, duración, reciprocidad y actualidad; no implica vínculo personal ni influencia causal."@es ;
  ontobricks:icon "🔗" .
qz:RelationshipGroup a owl:Class ; rdfs:label "Grupo de relaciones"@es ; ontobricks:icon "🕸️" .
qz:Country a owl:Class ; rdfs:label "País"@es ; ontobricks:icon "🌎" .
qz:Plan a owl:Class ; rdfs:label "Plan"@es ; ontobricks:icon "📱" .
qz:Product a owl:Class ; rdfs:label "Producto"@es ; ontobricks:icon "📦" .
qz:Ticket a owl:Class ; rdfs:label "Ticket de atención"@es ; ontobricks:icon "🎧" .
qz:SLA a owl:Class ; rdfs:label "Compromiso de SLA"@es ; ontobricks:icon "⏱️" .
qz:Recommendation a owl:Class ; rdfs:label "Recomendación"@es ; ontobricks:icon "💡" .
qz:Campaign a owl:Class ; rdfs:label "Campaña"@es ; ontobricks:icon "📣" .

qz:qualifiedContact a owl:ObjectProperty, owl:SymmetricProperty ;
  rdfs:label "tiene contacto calificado"@es ;
  rdfs:domain qz:Customer ; rdfs:range qz:Customer ;
  rdfs:comment "Atajo navegable. Los atributos auditables permanecen en la instancia reificada QualifiedContact."@es .
qz:contactSource a owl:ObjectProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range qz:Customer .
qz:contactTarget a owl:ObjectProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range qz:Customer .
qz:locatedIn a owl:ObjectProperty ; rdfs:domain qz:Customer ; rdfs:range qz:Country .
qz:memberOfRelationshipGroup a owl:ObjectProperty ; rdfs:domain qz:Customer ; rdfs:range qz:RelationshipGroup .
qz:subscribedTo a owl:ObjectProperty ; rdfs:domain qz:Customer ; rdfs:range qz:Plan .
qz:includesProduct a owl:ObjectProperty ; rdfs:domain qz:Plan ; rdfs:range qz:Product .
qz:openedBy a owl:ObjectProperty ; rdfs:domain qz:Ticket ; rdfs:range qz:Customer .
qz:governedBySLA a owl:ObjectProperty ; rdfs:domain qz:Customer ; rdfs:range qz:SLA .
qz:proposedFor a owl:ObjectProperty ; rdfs:domain qz:Recommendation ; rdfs:range qz:Customer .
qz:recommendsProduct a owl:ObjectProperty ; rdfs:domain qz:Recommendation ; rdfs:range qz:Product .
qz:recommendedProduct a owl:ObjectProperty ; rdfs:domain qz:Customer ; rdfs:range qz:Product .
qz:targetsCustomer a owl:ObjectProperty ; rdfs:domain qz:Campaign ; rdfs:range qz:Customer .

qz:baselineChurnProbability a owl:DatatypeProperty ;
  rdfs:label "probabilidad individual de churn"@es ;
  rdfs:domain qz:Customer ; rdfs:range xsd:double .
qz:retentionPriorityScore a owl:DatatypeProperty ;
  rdfs:label "prioridad de retención"@es ;
  rdfs:comment "Puntuación operativa de 0 a 100; no es una probabilidad."@es ;
  rdfs:domain qz:Customer ; rdfs:range xsd:double .
qz:networkReachScore a owl:DatatypeProperty ;
  rdfs:label "alcance en la red"@es ;
  rdfs:comment "Percentil compuesto que incluye PageRank ponderado; no representa influencia causal."@es ;
  rdfs:domain qz:Customer ; rdfs:range xsd:double .
qz:networkExposureScore a owl:DatatypeProperty ;
  rdfs:label "exposición relacional"@es ;
  rdfs:comment "Señal de 0 a 100 derivada del riesgo de los contactos y la difusión; no es una probabilidad de contagio."@es ;
  rdfs:domain qz:Customer ; rdfs:range xsd:double .
qz:callCount a owl:DatatypeProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range xsd:long .
qz:contactMinutes a owl:DatatypeProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range xsd:double .
qz:relationshipWeight a owl:DatatypeProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range xsd:double .
qz:isReciprocal a owl:DatatypeProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range xsd:boolean .
qz:qualificationReason a owl:DatatypeProperty ; rdfs:domain qz:QualifiedContact ; rdfs:range xsd:string .
