# Renombre como backend.tf y configure un único backend cifrado administrado por su organización.
# Nunca guarde claves de acceso en Git. Ejemplo para S3:
#
# terraform {
#   backend "s3" {
#     bucket       = "customer-terraform-state"
#     key          = "quetzal/dev/terraform.tfstate"
#     region       = "us-east-1"
#     encrypt      = true
#     use_lockfile = true
#   }
# }
