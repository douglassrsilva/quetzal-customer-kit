# Copie este archivo como config/customer.env y reemplace todos los valores de ejemplo.
# Incluya únicamente identificadores de recursos. Nunca guarde tokens ni secretos aquí.
DATABRICKS_CONFIG_PROFILE=customer-dev
DATABRICKS_HOST=https://customer-workspace.cloud.databricks.com

BUNDLE_VAR_app_name=quetzal-customer-dev
BUNDLE_VAR_catalog=acme_telco
BUNDLE_VAR_schema=quetzal
BUNDLE_VAR_sql_warehouse_id=0000000000000000
BUNDLE_VAR_workspace_id=0000000000000000
BUNDLE_VAR_ai_model=acme_telco.quetzal.quetzal-telecom-assistant
BUNDLE_VAR_admin_users=platform-admin@example.com
BUNDLE_VAR_app_user_group=quetzal-users
BUNDLE_VAR_app_admin_group=quetzal-admins

BUNDLE_VAR_lakebase_project=customer-lakebase
BUNDLE_VAR_lakebase_branch=production
BUNDLE_VAR_lakebase_endpoint=primary
BUNDLE_VAR_lakebase_database=quetzal
BUNDLE_VAR_lakebase_database_resource_id=quetzal
BUNDLE_VAR_lakebase_owner_role=projects/customer-lakebase/branches/production/roles/platform-admin
BUNDLE_VAR_lakebase_host=customer-lakebase.database.cloud.databricks.com
BUNDLE_VAR_lakebase_required=false

BUNDLE_VAR_managed_memory_store=acme_telco.quetzal.quetzal_iq_memory
BUNDLE_VAR_ontobricks_url=DISABLED
BUNDLE_VAR_ontobricks_domain=quetzal-telecom
BUNDLE_VAR_ontobricks_version=NOT_CONFIGURED
BUNDLE_VAR_ontology_base_uri=https://data.example.com/quetzal
BUNDLE_VAR_external_research_enabled=false

# Parámetros de los datos sintéticos deterministas. Cambie la fecha de referencia
# solo cuando necesite otra ventana temporal. Entradas iguales producen el mismo fingerprint.
BUNDLE_VAR_synthetic_customer_count=10000
BUNDLE_VAR_synthetic_seed=42
BUNDLE_VAR_synthetic_anchor_date=2026-09-29
